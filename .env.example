BOT_NAME=SUPER-BOT
PREFIX=/
OWNER_NUMBER=6282132687740
OWNER_LID=
# Jika Baileys menerima chat owner sebagai @lid, isi angka LID di sini (tanpa @lid juga boleh)

# Login WhatsApp: pairing atau qr
LOGIN_METHOD=qr
# Hanya dipakai jika LOGIN_METHOD=pairing
PAIRING_NUMBER=6289526173809
AUTO_READ=false
TIMEZONE=Asia/Jakarta

# AirBot
AIRBOT_GROUP_ID=120363429322868188@g.us
AIRBOT_API_URL=https://api.warungkode.my.id
AIRBOT_API_KEY=
AIRBOT_API_SECRET=
# QRIS yang diteruskan ke private dihapus otomatis setelah 10 menit
AIRBOT_QR_DELETE_MINUTES=10

# Auto voting badminton: Minggu->Senin, Kamis->Jumat jam 10:00 WIB
VOTING_GROUP_ID=120363416275139176@g.us
VOTING_ENABLED=true
VOTING_HOUR=10
VOTING_MINUTE=0

# Auto laporan saldo CEIR ke private owner (WIB mengikuti TIMEZONE)
SALDOCEIR_AUTO_ENABLED=true
SALDOCEIR_AUTO_HOURS=07,18
SALDOCEIR_AUTO_MINUTE=0

# Provider saldo
ROAMERCHECK_USERNAME=
ROAMERCHECK_API_KEY=
SICKW_API_KEY=
SICKW_USD_TO_IDR=19500
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=
ESIMACCESS_USD_TO_IDR=19500
ORDERKUOTA_MEMBER_ID=
ORDERKUOTA_PIN=
ORDERKUOTA_PASSWORD=
QCEIR_API_KEY=

# Gemini AI - status ON/OFF disimpan di database lewat /aion /aioff
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_SYSTEM_PROMPT=Kamu adalah asisten WhatsApp SUPER-BOT. Jawab ramah, jelas, ringkas, dan gunakan Bahasa Indonesia kecuali pengguna meminta bahasa lain.

# Downloader
YTDLP_PATH=yt-dlp
DOWNLOAD_MAX_SIZE=150M
DOWNLOAD_MAX_BYTES=157286400
DOWNLOAD_TIMEOUT_MS=180000
DOWNLOAD_TRANSCODE_TIMEOUT_MS=900000

# Website Monitor
MONITOR_INTERVAL_MINUTES=60
MONITOR_TIMEOUT_MS=12000

# V2 promotion: delay between consented recipient DMs
PROMO_DELAY_MS=10000

# QRIS dynamic
QRIS_STATIC=
QRIS_DELETE_MINUTES=5

# IMEI CENTER: /3b /1b /3bs /3bd
# API key hanya disimpan di .env VPS; jangan kirim di grup.
CEIRGO_API_BASE_URL=https://ceirgo.id
CEIRGO_API_KEY=
CEIRGO_IMEI_SERVICE_CODE=cek_imei
CEIRGO_TIMEOUT_MS=20000
CEIRGO_POLL_ATTEMPTS=8
CEIRGO_POLL_INTERVAL_MS=3000
# Nama bot untuk header empat layanan mengikuti BOT_NAME.
# Harga, operator per layanan, seller dan rekening diatur lewat WhatsApp owner.
# Invoice 21:00 WIB, backup owner 00:00 WIB; outstanding tidak dihapus.
