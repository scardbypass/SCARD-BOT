BOT_NAME=SCARD-BOT
PREFIX=/
OWNER_NUMBER=628xxxxxxxxxx
PAIRING_NUMBER=628xxxxxxxxxx
AUTO_READ=false
TIMEZONE=Asia/Jakarta

# AirBot
AIRBOT_GROUP_ID=120xxxxxxxxxxxxxxxx@g.us
AIRBOT_TIMEOUT_MS=15000
AIRBOT_BALANCE_COMMAND=/api saldo

# Auto voting badminton: Minggu->Senin, Kamis->Jumat jam 10:00 WIB
VOTING_GROUP_ID=120xxxxxxxxxxxxxxxx@g.us
VOTING_ENABLED=true
VOTING_HOUR=10
VOTING_MINUTE=0

# Provider saldo
ROAMERCHECK_USERNAME=
ROAMERCHECK_API_KEY=
SICKW_API_KEY=
SICKW_USD_TO_IDR=19500
QCEIR_API_KEY=

# Gemini AI - status ON/OFF disimpan di database lewat /aion /aioff
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SYSTEM_PROMPT=Kamu adalah asisten WhatsApp SCARD-BOT. Jawab ramah, jelas, ringkas, dan gunakan Bahasa Indonesia kecuali pengguna meminta bahasa lain.

# Downloader
YTDLP_PATH=yt-dlp
DOWNLOAD_MAX_SIZE=150M
DOWNLOAD_MAX_BYTES=157286400
DOWNLOAD_TIMEOUT_MS=180000
